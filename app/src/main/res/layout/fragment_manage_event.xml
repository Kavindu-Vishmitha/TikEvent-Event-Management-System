<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_margin="16dp"
        android:background="@drawable/custom_input_search"
        android:elevation="2dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/text_input_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Search Event"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:textColorHint="?android:attr/textColorSecondary"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/btn_search_action"
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_gravity="center"
                android:src="@drawable/search_24px"
                app:tint="?attr/colorOnPrimary" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view_events"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="60dp">
                <include layout="@layout/manage_event_section" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/event_24px"
                app:tint="?android:attr/textColorSecondary"
                android:alpha="0.5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:alpha="0.6"
                android:text="No Events Found"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
    </FrameLayout>
</LinearLayout>